#!/bin/bash
set -euo pipefail
exec 9>/run/lock/teteo-maintenance.lock
flock -n 9 || { echo 'Another maintenance operation is running'; exit 1; }
set -a; source {{ teteo_deploy }}/restic.env; set +a
mkdir -p {{ teteo_root }}/restore-tests
scratch=$(mktemp -d {{ teteo_root }}/restore-tests/test-XXXXXXXX)
restic restore latest --host teteo --tag nightly --target "$scratch"
count=0
while IFS= read -r -d '' repo; do
  git --git-dir="$repo" fsck --full
  count=$((count+1))
done < <(find "$scratch" -type d -name '*.git' -print0)
[ "$count" -gt 0 ] || { echo 'No restored Git repository found'; exit 1; }
python3 - "$scratch" <<'PYSQL'
import pathlib, sqlite3, sys
files = list(pathlib.Path(sys.argv[1]).rglob('pb_data/*.db'))
if not files:
    raise SystemExit('PocketBase database missing from restore')
for path in files:
    with sqlite3.connect('file:' + str(path) + '?mode=ro', uri=True) as db:
        result = db.execute('PRAGMA integrity_check').fetchone()[0]
        if result != 'ok':
            raise SystemExit(f'Failed SQLite integrity check: {path}')
print(f'PocketBase SQLite integrity verified: {len(files)} databases')
PYSQL
restic check
echo "Restore validated: $count repositories; retained at $scratch"
